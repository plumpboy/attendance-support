{
  "manifest_version": 3,
  "name": "SRA++",
  "description": "A chrome extension to log work on SRA",
  "options_page": "options.html",
  "background": {
    "service_worker": "background.bundle.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon-34.png"
  },
  "icons": {
    "128": "icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sra.smartosc.com/*"
      ],
      "js": [
        "contentScript.bundle.js"
      ]
    }
  ],
  "permissions": [
    "tabs",
    "scripting",
    "activeTab",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "*://*.smartosc.com/*",
    "*://*.zoho.com/*"
  ],
  "devtools_page": "devtools.html",
  "web_accessible_resources": [
    {
      "resources": [
        "content.styles.css",
        "icon-128.png",
        "icon-34.png"
      ],
      "matches": []
    }
  ]
}
